---
import Layout from '../../layouts/Layout.astro';
import NewsCards from '../../components/NewsCards.astro';
import { getPublishedNews } from '../../lib/server/content';
const news = await getPublishedNews();
---
<Layout title="Novinky | hkfree.org" description="Zprávy ze sítě, družstva a komunity hkfree.org.">
  <section class="dim">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">novinky</div>
        <h1>Co je nového v síti</h1>
        <p>Zprávy ze sítě, družstva a naší komunity.</p>
      </div>
      <NewsCards entries={news.slice(0, 3)} />
    </div>
  </section>
</Layout>
