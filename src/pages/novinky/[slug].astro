---
import Layout from '../../layouts/Layout.astro';
import { categories, formatDate } from '../../lib/news.mjs';
import { getPublishedNews } from '../../lib/server/content';
const entry = (await getPublishedNews()).find(item => item.id === Astro.params.slug);
if (!entry) return Astro.rewrite('/404');
---
<Layout title={`${entry.data.title} | hkfree.org`} description={entry.data.excerpt}>
  <div class="wrap article-wrap">
    <nav class="breadcrumb" aria-label="Drobečková navigace"><a href="/">Úvod</a> / <a href="/novinky/">Novinky</a></nav>
    <article>
      <header class="article-header">
        <div class="meta"><time datetime={entry.data.publishedAt}>{formatDate(entry.data.publishedAt)}</time> · {categories[entry.data.category]}</div>
        <h1>{entry.data.title}</h1>
        <p class="article-lead">{entry.data.excerpt}</p>
      </header>
      <div class="prose"><Fragment set:html={entry.html} /></div>
      <div class="article-footer"><a class="btn btn-dark" href="/novinky/">← Všechny novinky</a></div>
    </article>
  </div>
</Layout>
