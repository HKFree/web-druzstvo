      <div>
        <h5>Komunita</h5>
        <ul>
          <li><a href="https://spolek.hkfree.org">Spolek hkfree.org</a></li>
          <li><a href="https://facebook.com/hkfree">Facebook</a></li>
          <li><a href="https://x.com/hkfreeorg">X / Twitter</a></li>
          <li><a href="mailto:podpora@hkfree.org">Napište nám</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 hkfree.org internetové družstvo</span>
    </div>
  </div>
</footer>
