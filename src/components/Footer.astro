---
import { sitePath } from '../lib/paths';
import Logo from './Logo.astro';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="foot-logo" href={sitePath('/')} aria-label="hkfree.org — úvodní stránka"><Logo loading="lazy" /></a>
        <p class="foot-desc">Internetové družstvo. Komunitní síť v Hradci Králové a okolí od roku 2004.</p>
        <p class="foot-legal">IČ 22339485 · DIČ CZ22339485<br>datová schránka: zjbxjac<br>účet: 107207255/2010</p>
      </div>
      <div>
        <h5>Síť</h5>
        <ul>
          <li><a href="https://mapa.hkfree.org">Mapa pokrytí</a></li>
          <li><a href="https://moje.hkfree.org">Moje hkfree</a></li>
          <li><a href="https://power.hkfree.org/vypadky">Výpadky elektřiny</a></li>
          <li><a href="https://wiki.hkfree.org">Wiki</a></li>
        </ul>
      </div>
      <div>
        <h5>Služby</h5>
        <ul>
          <li><a href="https://mail.hkfree.org">Email</a></li>
          <li><a href="https://nas.hkfree.org">Uložiště</a></li>
          <li><a href="https://homes.hkfree.org">Userserver</a></li>
        </ul>
