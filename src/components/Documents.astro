---
import { getPublishedDocuments } from '../lib/server/content';
import { documentUrl } from '../lib/server/documents.mjs';
const documents = await getPublishedDocuments();
---
{documents.length ? <ul class="doclist rv" id="kontakt-docs">
  {documents.map(document => <li>
    <a href={documentUrl(document.id)}><span class="tag">PDF</span>{document.data.title}<span class="arrow" aria-hidden="true">→</span></a>
  </li>)}
</ul> : <p>Dokumenty právě připravujeme.</p>}
