---
import { sitePath } from '../lib/paths';
interface Props {
  loading?: 'eager' | 'lazy';
}
const { loading = 'eager' } = Astro.props;
---
<img
  class="brand-logo"
  src={sitePath('/images/hkfree-logo-druzstvo.png')}
  alt="hkfree.org — internetové družstvo"
  width="330"
  height="80"
  decoding="async"
  loading={loading}
/>
