---
import { sitePath } from '../lib/paths';
import Logo from './Logo.astro';
---
<div class="statusbar">
  <div class="wrap">
    <span><span class="dot"></span>síť v provozu</span>
    <span class="grow"></span>
    <a class="status-phone" href="tel:+420608101070"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92z" /></svg>608 10 10 70</a>
    {/* <a href="https://moje.hkfree.org">moje.hkfree.org →</a> */}
  </div>
</div>

<!-- header -->
<header class="site">
  <div class="wrap">
    <a class="logo" href={sitePath('/')} aria-label="hkfree.org — úvodní stránka"><Logo /></a>
    <nav class="main" id="main-nav" aria-label="Hlavní navigace">
      <a href={sitePath('/#kdo-jsme')}>Kdo jsme</a>
      <a href={sitePath('/#pripojeni')}>Připojení</a>
      <a href={sitePath('/#cena')}>Cena</a>
      <a href={sitePath('/#novinky')}>Novinky</a>
      <a href={sitePath('/#dokumenty')}>Dokumenty</a>
      <a href={sitePath('/#kontakt')}>Kontakt</a>
      <a class="btn btn-red cta" href={sitePath('/#pripojeni')}>Chci se připojit</a>
    </nav>
    <button class="burger" type="button" aria-controls="main-nav" aria-expanded="false">MENU</button>
  </div>
</header>

<style>
  .status-phone{display:inline-flex;align-items:center;gap:7px}
  .status-phone svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
</style>
