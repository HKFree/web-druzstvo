---
import type { NewsEntry } from '../lib/server/content';
import { categories, formatDate } from '../lib/news.mjs';
import { sitePath } from '../lib/paths';
interface Props { entries: NewsEntry[]; }
const { entries } = Astro.props;
---
{entries.length ? <div class="news">
  {entries.map(entry => (
    <a href={entry.data.body.discriminant === 'facebook' ? entry.data.body.value.facebookUrl : sitePath(`/novinky/${entry.id}/`)} class="rv">
      <span class="meta"><time datetime={entry.data.publishedAt}>{formatDate(entry.data.publishedAt)}</time> · {categories[entry.data.category]}</span>
      <h3>{entry.data.title}</h3>
      <p>{entry.data.excerpt}</p>
      <span class="more">{entry.data.body.discriminant === 'facebook' && <svg class="facebook-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-label="Facebook"><path fill="currentColor" d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.095 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.972h-1.513c-1.49 0-1.956.931-1.956 1.887v2.262h3.328l-.532 3.49h-2.796V24C19.612 23.095 24 18.1 24 12.073Z" /></svg>}Číst dál →</span>
    </a>
  ))}
</div> : <p>Právě připravujeme nové zprávy ze sítě.</p>}
