# Vývoj: npm run dev automaticky používá heslo, žádný OIDC server nepotřebuje.
ADMIN_USERNAME=redakce
ADMIN_PASSWORD=

# Produkce: výchozí je OIDC. Heslo ani AUTH_MODE=password v produkci nefungují.
# Pro vyzkoušení OIDC ve vývoji odkomentujte AUTH_MODE=oidc a vyplňte údaje níže.
# AUTH_MODE=oidc
DOMAIN=druzstvo.example.cz
# Prefix pro celý web i administraci. Změna vyžaduje nový build.
# Pro podsložku nastavte /v2, pro kořen ponechte /.
BASE_PATH=/
# HTTP port publikovaný Compose pouze na 127.0.0.1 pro Apache2 na stejném stroji.
WEB_PORT=4321
AUTH_ORIGIN=https://druzstvo.example.cz
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# true: přístup řídí poskytovatel OIDC, každý přihlášený uživatel je redaktor.
# false: vyplňte alespoň jeden seznam konkrétních účtů níže (oddělujte čárkou).
OIDC_ALLOW_ALL_AUTHENTICATED=true
OIDC_ALLOWED_SUBJECTS=
OIDC_ALLOWED_EMAILS=

# Pro spuštění bez Dockeru. Docker používá vlastní trvalý volume /app/data.
CONTENT_DIR=./data
HOST=127.0.0.1
PORT=4321
