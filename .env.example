# Jednorázové nastavení správcem. Redaktor používá jen /keystatic a tyto údaje.
ADMIN_USERNAME=redakce
ADMIN_PASSWORD=

# Veřejná doména pro Docker Compose a automatický HTTPS certifikát.
DOMAIN=druzstvo.example.cz

# Pro spuštění bez Dockeru. Docker používá vlastní trvalý volume /app/data.
CONTENT_DIR=./data
HOST=127.0.0.1
PORT=4321
